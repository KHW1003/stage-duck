# FastAPI 서버 이미지 (시연 서버용). 빌드: 저장소 맨 위에서 docker compose -f deploy/docker-compose.prod.yml build
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Seoul

WORKDIR /app

# 패키지 먼저 (코드만 바뀌면 이 층은 다시 받지 않는다)
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./

# root가 아닌 사용자로 실행. 업로드 폴더는 볼륨으로 붙는다 (specs/uploads.md)
RUN useradd --create-home --uid 1000 app && mkdir -p /uploads/public /uploads/private && chown -R app:app /app /uploads
USER app

EXPOSE 8000

# 1) 마이그레이션 적용 2) 서버 시작
# --workers 1: WebSocket 연결과 APScheduler가 한 프로세스에 있어야 한다 (plan.md 5.5·5.7)
# --proxy-headers: 앞의 Caddy가 붙인 X-Forwarded-* 를 믿는다 (https 판단·접속 IP)
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
