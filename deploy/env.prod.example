# 시연 서버 환경 변수 예시. 서버에서 이 파일을 deploy/.env 로 복사해 값을 채운다 (chmod 600).
# deploy/.env 는 커밋하지 않는다 (.gitignore의 .env).  비밀 값 만들기: openssl rand -hex 32
# 주석은 값 위 줄에만 쓴다 (값 뒤에 붙이면 값으로 읽힐 수 있다).

# --- 주소 ---
# EC2 고정 IP의 점(.)을 -로 바꾼 무료 주소 (예: 13.125.1.2 → 13-125-1-2.sslip.io), 또는 내 도메인
SITE_ADDRESS=13-125-1-2.sslip.io
# 인증서 만료 안내를 받을 팀 메일
ACME_EMAIL=
PUBLIC_BASE_URL=https://13-125-1-2.sslip.io

# --- 앱 (backend/app/core/config.py) ---
# 시연 서버는 test: 시연 계정 전환·데이터 초기화가 필요하다 (NFR-OPS-01)
APP_ENV=test
# 서명 키 두 개는 반드시 32바이트 이상 (openssl rand -hex 32 → 64자). 비거나 짧으면 api 가 시작하지 않는다
ADMIN_SESSION_SECRET=
JWT_SECRET=
# 발표 때 검색에 공개하려면 true (specs/seo.md)
SEO_INDEXING=false
# 검색 사이트 소유 확인 값 (선택, specs/seo.md). 네이버 서치어드바이저·구글 서치 콘솔에서 받은 content 값
SITE_VERIFICATION_NAVER=
SITE_VERIFICATION_GOOGLE=

# --- DB (compose가 DATABASE_URL을 만든다) ---
DB_NAME=stageduck
DB_USER=stageduck
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- 네이버 로그인 (선택) ---
# 네이버 개발자 센터에 콜백 https://{SITE_ADDRESS}/api/v1/auth/naver/callback 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_LOGIN_ENABLED=false
# 카카오를 켤 때만 (KAKAO_LOGIN_ENABLED=true)
KAKAO_CLIENT_ID=

# --- 메일 (비밀번호 재설정 링크, app/core/mail.py) ---
# console = 보내지 않고 서버 로그에만 남김 (+ APP_ENV=test 면 화면에 시연용 링크)
# smtp    = 실제로 보냄 (화면에는 링크를 보여 주지 않는다)
MAIL_BACKEND=console
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=보내는 Gmail 주소,
#   SMTP_PASSWORD=Google 계정 > 보안 > 2단계 인증 > "앱 비밀번호" 16자리 (계정 비밀번호 아님), MAIL_FROM=같은 Gmail 주소
# 네이버 예 (지금 쓰는 설정): SMTP_HOST=smtp.naver.com, SMTP_PORT=587, SMTP_USER=보내는 네이버 주소,
#   SMTP_PASSWORD=네이버 "애플리케이션 비밀번호"(2단계 인증 계정) 또는 계정 비밀번호, MAIL_FROM=같은 네이버 주소
#   네이버 메일 > 환경설정 > POP3/IMAP 설정에서 IMAP/SMTP "사용함"으로 바꿔야 보낼 수 있다
# AWS SES 예: SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com, SMTP_PORT=587, SES 콘솔의 SMTP 자격 증명, MAIL_FROM=인증한 주소
# 465 포트면 SSL, 그 밖은 STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=STAGE DUCK
