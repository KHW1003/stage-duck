# 실제 값은 backend/.env 에 넣고 커밋하지 않습니다.
APP_ENV=local
DATABASE_URL=mariadb+pymysql://stageduck:CHANGE_ME@localhost:3306/stageduck?charset=utf8mb4
ADMIN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM
JWT_SECRET=CHANGE_ME_LONG_RANDOM
UPLOAD_DIR=uploads

# 검색·공유 노출 (specs/seo.md 8장)
FRONTEND_DIST=../frontend/dist
PUBLIC_BASE_URL=http://localhost:8000
SEO_INDEXING=false
SITE_VERIFICATION_NAVER=
SITE_VERIFICATION_GOOGLE=
